  {
    "type": "effect_on_condition",
    "id": "EOC_Gamb_TribulationExit",
    "effect": [
      {
        "if": { "current_dimension": { "u_val": "trib_dimension_clear" } },
        "then": [
          { "u_travel_to_dimension": { "u_val": "pre_trib_dimension" } },
          { "u_teleport": { "u_val": "pre_trib_loc" }, "force": true },
          { "math": [ "u_spell_level('gamb_tribulation_exit') = -1" ] },
          { "clear_dimension": { "u_val": "trib_dimension_clear" } },
          { "math": [ "u_gamb_stage", "+=", "1" ] },
          { "math": [ "u_gamb_kireg", "=", "min(u_gamb_kireg,u_gamb_stage/10)" ] },
          { "math": [ "u_gamb_kicap", "=", "u_gamb_stage*15" ] },
          { "math": [ "u_gamb_talent_gained", "=", "max(0.1,gamb_ki_tribdif-1)" ] },
          { "math": [ "u_gamb_talent", "+=", "max(0.1,gamb_ki_tribdif-1)/3" ] },
          { "math": [ "u_gamb_phytalent", "+=", "max(0,(gamb_ki_tribdif-3)/4)" ] },
          { "math": [ "u_gamb_bodytalent", "+=", "max(0,(gamb_ki_tribdif-2)/3)" ] },
          { "math": [ "u_gamb_maxhp_true", "+=", "max(0,(gamb_ki_tribdif-1)/2)" ] },
          { "math": [ "u_gamb_speed_true", "+=", "max(0,(gamb_ki_tribdif-2)/4)" ] },
          { "math": [ "u_gamb_phytalent", "+=", "max(0,(gamb_ki_tribdif-2)/3)" ] },
          { "u_message": "You have gained <u_val:gamb_talent_gained> talent." }
        ],
        "else": { "u_message": "Go back to the tribulation dimension." }
      },
      {
        "if": { "not": { "u_has_trait": "Cultivator_Gamb" } },
        "then": { "u_add_trait": "Cultivator_Gamb", "variant": "Qi_Gathering1" }
      }
    ]
  },
