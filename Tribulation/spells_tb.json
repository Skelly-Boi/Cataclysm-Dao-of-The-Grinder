  {
    "type": "SPELL",
    "id": "gamb_tribulation_exit",
    "name": "Leave Tribulation",
    "description": "Congratulations, you have survived.",
    "flags": [ "SILENT", "NO_FAIL", "NON_MAGICAL", "NO_HANDS", "NO_LEGS" ],
    "valid_targets": [ "self" ],
    "base_casting_time": 0,
    "base_energy_cost": 0,
    "energy_source": "STAMINA",
    "shape": "blast",
    "effect": "effect_on_condition",
    "effect_str": "EOC_Gamb_TribulationExit"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_Gamb_TribulationExit",
    "effect": [
      {
        "if": { "current_dimension": { "u_val": "trib_dimension_clear" } },
        "then": [
          { "u_travel_to_dimension": { "u_val": "pre_trib_dimension" } },
          { "u_teleport": { "u_val": "pre_trib_loc" }, "force": true },
          { "math": [ "u_spell_level('gamb_tribulation_exit') = -1" ] },
          { "clear_dimension": { "u_val": "trib_dimension_clear" } },
          { "math": [ "u_gamb_stage", "+=", "1" ] },
          { "math": [ "u_gamb_tribactive = 0" ] },
          { "math": [ "u_gamb_kireg", "=", "min(u_gamb_kireg,u_gamb_stage/10)" ] },
          { "math": [ "u_gamb_kicap", "=", "min(u_gamb_kicap,u_gamb_stage*15)" ] },
          { "math": [ "u_gamb_talent_gained", "=", "max(0.1,gamb_ki_tribdif-1)" ] },
          { "math": [ "u_gamb_talent", "+=", "max(0.1,gamb_ki_tribdif-1)/3" ] },
          { "math": [ "u_gamb_phytalent", "+=", "max(0,(gamb_ki_tribdif-3)/4)" ] },
          { "math": [ "u_gamb_bodytalent", "+=", "max(0,(gamb_ki_tribdif-2)/3)" ] },
          { "math": [ "u_gamb_maxhp_true", "+=", "max(0,(gamb_ki_tribdif-1)/2)" ] },
          { "math": [ "u_gamb_speed_true", "+=", "max(0,(gamb_ki_tribdif-2)/4)" ] },
          { "math": [ "u_gamb_phytalent", "+=", "max(0,(gamb_ki_tribdif-2)/3)" ] },
          { "u_message": "You have gained <u_val:gamb_talent_gained> talent." }
        ],
        "else": { "u_message": "Go back to the tribulation dimension." }
      },
      { "u_lose_trait": "Cultivator_Gamb" },
      {
        "switch": { "math": [ "u_gamb_stage" ] },
        "cases": [
          { "case": 0, "effect": [ { "u_message": "Cultivation Stage 0 (Bug)", "type": "bad" } ] },
          {
            "case": 1,
            "effect": [
              { "u_add_trait": "Cultivator_Gamb", "variant": "Qi_Gathering1" },
              {
                "if": { "u_has_trait": "REALLYBADKNEES" },
                "then": [ { "u_lose_trait": "REALLYBADKNEES" }, { "u_add_trait": "BADKNEES" } ],
                "else": { "if": { "u_has_trait": "BADKNEES" }, "then": { "u_lose_trait": "BADKNEES" } }
              },
              {
                "if": { "u_has_trait": "FLIMSY3" },
                "then": [ { "u_lose_trait": "FLIMSY3" }, { "u_add_trait": "FLIMSY2" } ],
                "else": {
                  "if": { "u_has_trait": "FLIMSY2" },
                  "then": [ { "u_lose_trait": "FLIMSY2" }, { "u_add_trait": "FLIMSY" } ],
                  "else": { "if": { "u_has_trait": "FLIMSY" }, "then": { "u_lose_trait": "FLIMSY" } }
                }
              },
              {
                "if": { "u_has_trait": "SLOWHEALER3" },
                "then": [ { "u_lose_trait": "SLOWHEALER3" }, { "u_add_trait": "SLOWHEALER2" } ],
                "else": {
                  "if": { "u_has_trait": "SLOWHEALER2" },
                  "then": [ { "u_lose_trait": "SLOWHEALER2" }, { "u_add_trait": "SLOWHEALER" } ],
                  "else": { "if": { "u_has_trait": "SLOWHEALER" }, "then": { "u_lose_trait": "SLOWHEALER" } }
                }
              },
              { "u_lose_trait": "NOHEAL" },
              { "u_lose_trait": "BADBACK" },
              { "u_lose_trait": "GLASSJAW" },
              { "u_lose_trait": "CLUMSY" },
              { "u_lose_trait": "BADCARDIO" },
              { "u_lose_trait": "SLOWRUNNER" },
              { "u_lose_trait": "WEAKSTOMACH" },
              { "u_lose_trait": "CHAOTIC_BAD" }
            ]
          },
          { "case": 2, "effect": { "u_add_trait": "Cultivator_Gamb", "variant": "Qi_Gathering2" } },
          { "case": 3, "effect": { "u_add_trait": "Cultivator_Gamb", "variant": "Qi_Gathering3" } }
        ]
      }
    ]
  },
